# Run python3 deploy/init_env.py to create .env with random secrets.
SECRET_KEY=GENERATE_ME
ADMIN_PASSWORD=GENERATE_ME
# Alternative: ADMIN_PASSWORD_HASH from werkzeug.security.generate_password_hash
ADMIN_PASSWORD_HASH=
# Keep 1 behind HTTPS; use 0 only for local HTTP preview / SSH tunnel.
COOKIE_SECURE=1
DATA_DIR=/data
PORT=8080
DOMAIN=studio.example.com

# A common key can be used for all OpenAI adapters. Never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TEXT_API_KEY=
TEXT_BASE_URL=https://api.openai.com/v1
TEXT_ADAPTER=openai
TEXT_MODEL=gpt-6-astra
TEXT_MAX_OUTPUT_TOKENS=16000
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_QUALITY=max
VIDEO_API_KEY=
VIDEO_BASE_URL=https://api.openai.com/v1
VIDEO_ADAPTER=openai
VIDEO_MODEL=sora-2-pro
VIDEO_RESOLUTION=1080p
# Only used for provider-returned media URLs, never for request credentials.
MEDIA_HOST_SUFFIXES=volces.com,volccdn.com,byteimg.com,openai.com,blob.core.windows.net
